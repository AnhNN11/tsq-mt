# Runtime: configure on Vercel
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server only: required for admin account CRUD
SUPABASE_SECRET_KEY=your_server_secret_key

# One-time provisioning only. Never use NEXT_PUBLIC for these.
APP_USERS_JSON='[{"username":"admin","password":"replace_with_a_secure_password","name":"Quản trị viên","role":"admin","subjects":[]}]'
APP_SEED_PATH=data/initial-workspace.json
