# Runtime: configure on Vercel
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server only: required for account CRUD, gradebook, capture and image processing
SUPABASE_SECRET_KEY=your_server_secret_key

# Optional: local E2E only; no account list or password config is needed on Vercel.
# E2E_ACCOUNT_PASSWORD=your_local_test_login_password

# Optional public base for phone capture. On Vercel, omit to use the current site,
# or set your HTTPS production domain. Never deploy a private LAN address here.
# APP_PUBLIC_URL=https://your-school-site.vercel.app

# Optional server only: cleanup of legacy temporary photos from the old flow.
# Direct phone grading does not store photos.
# Generate a random value of at least 32 characters and set it on Vercel.
CRON_SECRET=your_random_cleanup_secret_at_least_32_characters
