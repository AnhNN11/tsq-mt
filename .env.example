# Runtime: configure on Vercel
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server only: required for admin account CRUD
SUPABASE_SECRET_KEY=your_server_secret_key

# Optional: local E2E only; no account list or password config is needed on Vercel.
# E2E_ACCOUNT_PASSWORD=your_local_test_login_password
